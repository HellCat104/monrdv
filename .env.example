# ============================================================
# MonRDV — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ============================================================

# --- Supabase (obligatoire) ---
# Trouvez ces valeurs dans : Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Twilio SMS (obligatoire pour les notifications) ---
# Créez un compte sur twilio.com et récupérez ces valeurs
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Numéro Twilio ou nom alphanumérique (ex: MonRDV, max 11 car.)
TWILIO_PHONE_NUMBER=+12125551234

# --- URL de l'application (obligatoire) ---
# En développement : http://localhost:3000
# En production : https://votre-domaine.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron job secret (obligatoire pour les rappels) ---
# Générez une chaîne aléatoire sécurisée : openssl rand -hex 32
CRON_SECRET=votre_secret_tres_long_et_aleatoire

# --- Email Resend (obligatoire pour les notifications) ---
# Créez un compte sur resend.com (gratuit) et récupérez votre API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Email expéditeur (doit être un domaine vérifié dans Resend)
EMAIL_FROM=MonRDV <noreply@monrdv.ma>

# --- Admin ---
# Votre email pour accéder au dashboard admin (/admin)
# IMPORTANT : utiliser ADMIN_EMAIL (server-only), jamais NEXT_PUBLIC_ADMIN_EMAIL
ADMIN_EMAIL=votre_email_admin@exemple.com

# --- Sentry (monitoring des erreurs) ---
# Créez un projet sur sentry.io et récupérez le DSN
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# --- Rate limiting distribué (obligatoire en production) ---
# Créez une base Redis sur Upstash et copiez les identifiants REST.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx

# --- Stripe (optionnel — décommentez pour activer) ---
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
